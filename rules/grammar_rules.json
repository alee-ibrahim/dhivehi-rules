 "rules": [
  {
   "id": "gr_honorific_first_person",
   "severity": "error",
   "pattern": "(?<![ހ-޿])([ހ-޿]*)ކުރައްވާނަން(?![ހ-޿])",
   "replace": "\\1ކުރާނަން",
   "why": "-ނަން is first person ('I/we will'). Honorific verbs (ކުރައްވާ, ދެއްވާ, ބައްލަވާ...) are for the person addressed or spoken about, never for yourself. 'އަޅުގަނޑުމެން ޑެލިވަރީ ކޮށްދެއްވާނަން' is wrong. The speaker humbles their own verb: ކުރާނަން, ކޮށްދޭނަން, ދަންނަވާނަން.",
   "evidence": "News+speeches+Majlis: ...ކުރައްވާނަން 43 against ...ކުރާނަން 57,238 (0.08%). Sampled hits are quoted speech in headlines."
  },
  {
   "id": "gr_honorific_first_person",
   "severity": "error",
   "pattern": "(?<![ހ-޿])([ހ-޿]*)ދެއްވާނަން(?![ހ-޿])",
   "replace": "\\1ދޭނަން",
   "why": "As above: ކޮށްދެއްވާނަން / ދެއްވާނަން is the honorific verb with the first-person ending. Say ކޮށްދޭނަން / ދޭނަން.",
   "evidence": "...ދެއްވާނަން 136 against ...ދޭނަން 20,152 (0.7%). Most of the 136 are one headline repeated: 'މޯދީއަށް އެއްބާރުލުން ދެއްވާނަން: ޓްރަމްޕް'."
  },
  {
   "id": "gr_honorific_first_person",
   "severity": "error",
   "pattern": "(?<![ހ-޿])(ބައްލަވާ|ގުޅުއްވާ|ހޯއްދަވާ|ދައްކަވާ|ވިދާޅުވާ|ވަޑައިގަންނަވާ)ނަން(?![ހ-޿])",
   "replace": "",
   "why": "Honorific verb with the first-person ending. Use the plain verb for yourself: ބަލާނަން, ގުޅާނަން, ހޯދާނަން, ދައްކާނަން, ދަންނަވާނަން (not ވިދާޅުވާނަން), ދާނަން/އަންނާނަން.",
   "evidence": "These six honorific -ނަން forms: 9 in total, against 11,614 for ބަލާނަން/ގުޅާނަން/ހޯދާނަން/ދައްކާނަން/ދަންނަވާނަން/ދާނަން/އަންނާނަން."
  },
  {
   "id": "gr_numeral_plural",
   "severity": "error",
   "pattern": "(?<![ހ-޿])(ދެ|ތިން|ހަތަރު|ފަސް|ހަތް|ނުވަ|ދިހަ) (?!ކަންތައް|ކަންތަކެއް)([ހ-޿]+?)(?:ތައް|ތަކެއް)(?![ހ-޿])",
   "replace": "\\1 \\2",
   "why": "After a numeral the noun stays singular: ދެ ކުލަ, ތިން ބާވަތް, not ދެ ކުލަތައް. The one lexicalised exception is ކަންތައް ('matters'): ދެ ކަންތައް is normal.",
   "evidence": "Numeral word + a noun in -ތައް/-ތަކެއް: 289, against 1,022,764 numeral + word (0.03%). Numeral + ކަންތައް: 1,454, so it is exempt."
  },
  {
   "id": "gr_plural_uncountable",
   "severity": "error",
   "pattern": "(?<![ހ-޿])([ހ-޿]+ތެރިކަ)(?:ން|މް)(?:ތައް|ތަކެއް)(?![ހ-޿])",
   "replace": "\\1ން",
   "why": "Abstract -ތެރިކަން nouns are not pluralised: ބޭނުންތެރިކަން, not ބޭނުންތެރިކަންތައް (an English 'benefits' calque). To list several, name them or use ބޭނުންތެރި ކަންތައްތައް / ފައިދާތައް.",
   "evidence": "-ތެރިކަން with a plural suffix: 0 real uses in the corpus. The 10 regex hits are all the question particle ތަ؟. Tokens in -ތެރިކަން: 118,748."
  },
  {
   "id": "gr_plural_uncountable",
   "severity": "error",
   "pattern": "(?<![ހ-޿])(ލޯބި|ޝުކުރު|ހޫނު|ހިލޭ|ކޮލިޓީ)(?:ތައް|ތަކެއް)(?![ހ-޿])",
   "replace": "\\1",
   "why": "Mass nouns that Dhivehi does not pluralise.",
   "evidence": "Corpus vocabulary: ލޯބި 12,383 / plural 0; ޝުކުރު 20,555 / 0; ހޫނު 8,779 / 0; ހިލޭ 23,992 / 0; ކޮލިޓީ 3,169 / 22 (0.7%)."
  },
  {
   "id": "gr_sentence_initial_nama",
   "severity": "error",
   "pattern": "(?:^|(?<=[.!؟?\\n]\\s)|(?<=[.!؟?\\n]))ނަމަ(?=\\s*،)",
   "replace": "ނަމަވެސް",
   "why": "'However' at the start of a sentence is ނަމަވެސް. Bare ނަމަ means 'if' and closes a conditional clause ('ސުވާލެއް އޮތް ނަމަ، ...'); it cannot start one.",
   "evidence": "Sentence-initial 'ނަމަވެސް،' 34,553; sentence-initial 'ނަމަ،' 9."
  },
  {
   "id": "gr_nama_after_finite",
   "severity": "error",
   "pattern": "(?<![ހ-޿])([ހ-޿]+ެވެ) ނަމަ(?![ހ-޿])",
   "replace": "",
   "why": "ނަމަ ('if') follows a participle or a verbal form (ކުރާ ނަމަ, ހުރި ނަމަ, ކޮށްފި ނަމަ), never the sentence-final -އެވެ form. Drop the -އެވެ ending: 'ހުރެއެވެ ނަމަ' becomes 'ހުރި ނަމަ'.",
   "evidence": "Finite -ެވެ + ނަމަ: 1 in the corpus, against 139,675 word + ނަމަ."
  }
 ]
